{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor-cbt",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "account_id": "212a78d4cea6e1047658a98ba757cd2b",
  // Only entry point: the workers.dev URL, protected by Cloudflare Access (T12).
  // No routes or Custom Domain; preview URLs are off so nothing bypasses Access.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
