{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor-cbt",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "account_id": "212a78d4cea6e1047658a98ba757cd2b",
  // Only entry point: the workers.dev URL, protected by Cloudflare Access (T12).
  // No routes or Custom Domain; preview URLs are off so nothing bypasses Access.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Daily task at 01:00 UTC (20:00 ECT), one hour after the UTC day closes (R28, P3).
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  // Not secrets. While ACCESS_TEAM_DOMAIN or ACCESS_AUD is empty, every /api/* request is denied (R3).
  // ACCESS_AUD is the AUD tag of the Access application of this Worker.
  // LOCAL_ACCESS_BYPASS is "false" in production; only web/.dev.vars may set it to "true" (R4).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://winter-unit-dba9.cloudflareaccess.com",
    "ACCESS_AUD": "bf0abbe6cfeadbc215c84b9a878f6f69c0706e997c33c7b8470fd4dba9e07893",
    "LOCAL_ACCESS_BYPASS": "false"
  },
  // Deploy fails if these are not set as Worker secrets.
  "secrets": {
    "required": ["CLOUDFLARE_ANALYTICS_TOKEN", "ALLOWED_EMAILS"]
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "monitor-cbt-audit-db",
      "database_id": "10f769ba-117e-4e33-82cb-6cb341f12a70",
      "migrations_dir": "migrations/audit"
    },
    {
      "binding": "STATS_DB",
      "database_name": "monitor-cbt-statistics-db",
      "database_id": "81e82feb-90ef-4e07-b72e-6ea22c0a9bbc",
      "migrations_dir": "migrations/statistics"
    }
  ]
}
