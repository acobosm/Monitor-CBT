{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor-cbt",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "account_id": "212a78d4cea6e1047658a98ba757cd2b",
  // Only entry point: the workers.dev URL, protected by Cloudflare Access (T12).
  // No routes or Custom Domain; preview URLs are off so nothing bypasses Access.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Not secrets. Empty until Access is configured (T12): while empty, every /api/* request is denied (R3).
  // ACCESS_TEAM_DOMAIN looks like https://<team>.cloudflareaccess.com; ACCESS_AUD is the application AUD tag.
  // LOCAL_ACCESS_BYPASS is "false" in production; only web/.dev.vars may set it to "true" (R4).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "LOCAL_ACCESS_BYPASS": "false"
  },
  // Deploy fails if these are not set as Worker secrets.
  "secrets": {
    "required": ["CLOUDFLARE_ANALYTICS_TOKEN", "ALLOWED_EMAILS"]
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "monitor-cbt-audit-db",
      // Placeholder for local development; the real ID is set when the database is created (T12).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/audit"
    }
  ]
}
